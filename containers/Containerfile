FROM docker.io/library/node:24-trixie-slim AS development

# Electron, native module compilation, and a desktop reachable through noVNC.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git python3 make g++ pkg-config \
    libasound2t64 libatk1.0-0t64 libatk-bridge2.0-0t64 libatspi2.0-0t64 \
    libcups2t64 libdrm2 libgbm1 libgtk-3-0t64 libnss3 libx11-xcb1 \
    libxcomposite1 libxdamage1 libxfixes3 libxkbcommon0 libxrandr2 \
    libsecret-1-0 libxss1 libxtst6 fonts-liberation \
    dbus-x11 fluxbox novnc websockify x11vnc xvfb x11-utils tini procps \
    && rm -rf /var/lib/apt/lists/*
# Dyad's locked native packages rely on install hooks (Electron download and
# native binding compilation). npm 11 silently skips unapproved hooks in fresh
# containers, so use the compatible npm 10 release for the lockfile install.
RUN npm install --global npm@10.9.4 pnpm@10.11.0

WORKDIR /opt/dyad
COPY --chown=node:node package.json package-lock.json .npmrc ./
COPY --chown=node:node packages ./packages
COPY --chown=node:node native ./native
RUN chown node:node /opt/dyad
USER node
RUN npm ci
COPY --chown=node:node testing/fake-llm-server/package*.json ./testing/fake-llm-server/
RUN npm --prefix testing/fake-llm-server ci
COPY --chown=node:node . .
RUN mkdir -p userData

FROM development AS desktop
# Package the real application; npm run build creates an E2E-specific build.
RUN npm run package && \
    ln -s /opt/dyad/out/dyad-linux-$(node -p 'process.arch')/dyad /opt/dyad/desktop
ENV DISPLAY=:99
EXPOSE 6080
ENTRYPOINT ["/usr/bin/tini", "--", "/bin/bash", "/opt/dyad/containers/desktop.sh"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:6080/vnc.html > /dev/null && pgrep -x dyad > /dev/null
